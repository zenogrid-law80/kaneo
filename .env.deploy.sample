# Copy to .env.deploy.local and select one login type below.
# Load the file from the repository root, then run the deployment script:
#   set -a
#   source .env.deploy.local
#   set +a
#   ./scripts/deploy-kaneo-arm64.sh
# This builds, pushes, and deploys. The remote Compose service's image must
# match the selected registry/repository/tag.

# Login types: ecr (default), dockerhub, registry.
DOCKER_LOGIN_TYPE=ecr
IMAGE_TAG=latest

# Amazon ECR: uses the AWS CLI credential chain locally and on the remote host.
AWS_REGION=ap-northeast-2
ECR_REGISTRY=174376947686.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REPOSITORY=kaneo
# AWS_PROFILE=default # Optional local AWS profile; not forwarded over SSH.

# Docker Hub: set DOCKER_LOGIN_TYPE=dockerhub and uncomment these settings.
# DOCKER_USERNAME=your-docker-hub-user
# DOCKER_PASSWORD=your-personal-access-token
# DOCKER_REPOSITORY=your-docker-hub-user/kaneo

# Other registries: set DOCKER_LOGIN_TYPE=registry and uncomment these settings.
# Use a hostname (optionally with a port), without https:// or a repository path.
# DOCKER_REGISTRY=registry.example.com
# DOCKER_USERNAME=your-registry-user
# DOCKER_PASSWORD=your-registry-access-token
# DOCKER_REPOSITORY=your-team/kaneo

# Keep actual credentials only in the ignored .env.deploy.local or shell env.
# Quote shell-special characters in values. Passwords/tokens are sent to
# docker login through stdin locally and through encrypted SSH stdin remotely.

# Optional deployment overrides (these are the script defaults).
# LOCAL_IMAGE=kaneo:latest
# SSH_HOST=doc.zenogrid.co.kr
# SSH_PORT=22
# SSH_USER=ec2-user
# SSH_KEY="${HOME}/.ssh/key_zenogrid.pem"
# REMOTE_COMPOSE_DIR=outline
# COMPOSE_SERVICE=kaneo
