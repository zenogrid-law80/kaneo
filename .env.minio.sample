# Copy to .env.minio.local and generate separate passwords with openssl rand -hex 32.
MINIO_ROOT_USER=kaneo-minio-admin
MINIO_ROOT_PASSWORD=replace-with-generated-admin-password
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

S3_ENDPOINT=http://minio.localhost:9000
S3_BUCKET=kaneo-uploads
S3_ACCESS_KEY_ID=kaneo-local-uploads
S3_SECRET_ACCESS_KEY=replace-with-generated-upload-password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
